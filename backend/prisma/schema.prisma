generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── Enums ─────────
enum ProductBadge {
  BESTSELLER
  NEW
  CHEFS_PICK
  POPULAR
  LIMITED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum TimeWindow {
  MORNING
  AFTERNOON
  EVENING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum RequestStatus {
  NEW
  CONTACTED
  DONE
}

// ───────── Admin ─────────
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ───────── Catalog ─────────
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  shortDescription String?
  description      String?
  ingredients      String?
  allergyInfo      String?
  imageUrl         String?
  badge            ProductBadge?
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  categoryId       Int
  category         Category         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  dietaryTags      DietaryTag[]
  flavors          Flavor[]
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  basePrice        Int              @default(0)

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileId    String?
  @@index([productId])
}

// المقاس أو العلبة، ولكل واحد سعره ومخزونه (السعر بالدينار DZD)
model ProductVariant {
  id         Int         @id @default(autoincrement())
  label      String // مثال: "8 inch" أو "Box of 6"
  serves     String? // مثال: "8-10 guests"
  price      Int
  stock      Int         @default(0)
  isActive   Boolean     @default(true)
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model DietaryTag {
  id       Int       @id @default(autoincrement())
  name     String    @unique // Vegan, Gluten-Free, Nut-Free, Halal...
  slug     String    @unique
  products Product[]
}

model Flavor {
  id       Int       @id @default(autoincrement())
  name     String    @unique // Strawberry, Pistachio...
  slug     String    @unique
  products Product[]
}

model Review {
  id         Int      @id @default(autoincrement())
  authorName String
  rating     Int // 1..5
  comment    String?
  isApproved Boolean  @default(false)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

// ───────── Orders (COD + guest checkout) ─────────
model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique // مثال: SB-20261015-0001
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  isPaid        Boolean       @default(false) // يحدده الأدمن عند التسليم

  customerName String
  phone        String
  email        String?
  wilaya       String
  address      String
  notes        String?

  deliveryType DeliveryType @default(DELIVERY)
  deliveryDate DateTime?
  timeWindow   TimeWindow?

  isGift      Boolean @default(false)
  giftMessage String?

  subtotal    Int
  discount    Int     @default(0)
  deliveryFee Int     @default(0)
  total       Int
  couponCode  String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product         @relation(fields: [productId], references: [id])
  variantId    Int?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productName  String // نسخة محفوظة وقت الطلب
  variantLabel String?
  unitPrice    Int // السعر وقت الطلب
  quantity     Int
  inscription  String? // الكتابة على الكيك

  @@index([orderId])
}

// ───────── Extras ─────────
model Coupon {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  type      DiscountType
  value     Int
  minOrder  Int          @default(0)
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  isActive  Boolean      @default(true)
}

model DeliveryZone {
  id        Int     @id @default(autoincrement())
  wilaya    String  @unique
  fee       Int
  freeAbove Int? // توصيل مجاني فوق هذا المبلغ
  isActive  Boolean @default(true)
}

model CustomCakeRequest {
  id          Int           @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  eventDate   DateTime?
  guests      Int?
  description String
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
